# Copie este arquivo para .env e preencha com valores reais.
# Não versionar .env com segredos.

# Chave secreta usada para assinar cookies/sessões.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-forte-aleatoria

# Tempo de expiração da sessão em minutos. O valor atual do projeto é 8 horas.
SESSION_TTL_MINUTES=480

# Em desenvolvimento local, use false. Em produção HTTPS, use true.
COOKIE_SECURE=false
